#include <stdio.h>
#include <string.h>
int main()
{
    int t;
    char s1[4] = "YES";
    scanf("%d", &t);
 
    while (t--)
    {
        char s2[4];
        scanf("%s", s2);
 
        int r = strcasecmp(s1, s2);
 
        if (r == 0)
        {
            printf("YES
");
        }
        else
        {
            printf("NO
");
        }
    }
    return 0;
}